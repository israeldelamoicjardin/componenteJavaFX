<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root alignment="CENTER" prefHeight="110.0" prefWidth="800.0" style="-fx-border-color: blue; -fx-background-radius: 2px;" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

      <children>
      <VBox alignment="CENTER_LEFT" prefHeight="108.0" prefWidth="300.0" HBox.hgrow="NEVER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="147.0" VBox.vgrow="ALWAYS">
               <children>
                  <ImageView fx:id="iv_pais_origen" accessibleText="bandera" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" />
                     <Label fx:id="lb_pais_origen" prefHeight="17.0" prefWidth="336.0" text="pais_origen" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Arial Black" size="12.0" />
                     </font></Label>
               </children>
            </HBox>
            <Label fx:id="lb_provincia_origen" prefHeight="17.0" prefWidth="309.0" text="provincia_origen">
            </Label>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="210.0">
               <children>
                  <ImageView fx:id="iv_pais_destino" accessibleText="bandera" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" />
                     <Label fx:id="lb_pais_destino" prefHeight="17.0" prefWidth="286.0" text="pais_destino" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Arial Black" size="12.0" />
                     </font></Label>
