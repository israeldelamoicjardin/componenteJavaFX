<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root alignment="CENTER" prefHeight="90.0" prefWidth="300.0" style="-fx-border-color: blue; -fx-background-radius: 2px;" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

      <children>
      <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="NEVER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ImageView fx:id="iv_pais_origen" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" />
                     <Label fx:id="lb_pais_origen" text="pais_origen" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Segoe UI Emoji" size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label fx:id="lb_provincia_origen" text="provincia_origen">
               <font>
                  <Font name="Segoe UI Emoji" size="12.0" />
               </font>
            </Label>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ImageView fx:id="iv_pais_destino" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" />
