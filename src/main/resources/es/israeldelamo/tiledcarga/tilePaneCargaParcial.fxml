            </HBox>
            <Label fx:id="lb_provincia_destino" prefHeight="17.0" prefWidth="324.0" text="provincia_destino">
            </Label>
         </children>
         <padding>
            <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
         </padding>
      </VBox>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="NEVER">
         <children>
               <Label fx:id="lb_dimension" alignment="CENTER" contentDisplay="CENTER" prefHeight="17.0" prefWidth="220.0" text="dimension_h" textAlignment="CENTER" />
            <Label fx:id="lb_carga_completa_o_grupaje" alignment="CENTER" contentDisplay="CENTER" layoutX="27.0" layoutY="52.0" prefHeight="44.0" prefWidth="221.0" text="lb_carga_completa_o_grupaje" textAlignment="CENTER" textOverrun="CLIP" wrapText="true" VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="1.0" left="1.0" right="1.0" top="1.0" />
         </padding>
      </VBox>
      <VBox alignment="CENTER_RIGHT" prefHeight="200.0" prefWidth="300.0" HBox.hgrow="NEVER">
         <children>
               <Label fx:id="lb_peso_unitario" alignment="CENTER_RIGHT" contentDisplay="RIGHT" prefHeight="17.0" prefWidth="341.0" text="peso_unitario" textAlignment="RIGHT" />
